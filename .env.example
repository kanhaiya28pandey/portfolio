# ==============================================================================
# Full-Stack Portfolio & CMS - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file as `.env` in the project root:
#    cp .env.example .env
# 2. Fill in your own credentials below.
# 3. NEVER commit your real `.env` file to GitHub!
# ==============================================================================

# 1. Spring Boot Environment Profile
# Options: 'prod' (PostgreSQL) or 'dev' (Embedded H2 file database)
SPRING_PROFILES_ACTIVE=prod

# 2. Admin CMS Login Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password

# 3. Security & JWT Token Signing
# Generate a 256-bit secret key (at least 64 hex/alphanumeric characters)
JWT_SECRET=replace_with_at_least_64_characters_random_hex_or_base64_string

# 4. Live SMTP Email Notifications (Optional - for inquiry notification alerts)
MAIL_ENABLED=true
MAIL_RECIPIENT=your_notification_email@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_sender_gmail@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password

# 5. CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 6. Production PostgreSQL Database (Local pgAdmin or Cloud Database)
# Example Local: jdbc:postgresql://localhost:5432/portfolio_db
# Example Cloud: jdbc:postgresql://ep-xyz.region.aws.neon.tech/portfolio_db?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password

# Docker Compose Settings (Only needed if running via docker compose)
POSTGRES_DB=portfolio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# 7. Frontend API Base URL
VITE_API_URL=http://localhost:8080/api/v1
