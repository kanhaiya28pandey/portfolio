# ==============================================================================
# Git Ignore Configuration - Protects Secrets, Builds, and Data
# ==============================================================================

# 1. Environment & Secret Files (CRITICAL - NEVER COMMIT TO GITHUB)
.env
.env.*
!.env.example
*.env
*.env.local

# 2. Local Uploads & User Media (Contains user resumes, certificates, IDs)
uploads/
**/uploads/
backend/uploads/
data/
**/data/*.mv.db
**/data/*.trace.db
*.db

# 3. Node & Frontend Builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 4. Java & Maven Builds
target/
**/target/
.mvn/wrapper/maven-wrapper.jar

# 5. IDE & OS Metadata
.idea/
**/.idea/
*.iws
*.iml
*.ipr
.vscode/
**/.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.DS_Store
Thumbs.db
*.log
